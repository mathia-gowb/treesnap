{
  "name": "treegen-cli",
  "version": "1.0.0",
  "description": "Generate and export clean directory trees for software projects.",
  "type": "module",
  "bin": {
    "treegen": "./src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./src/cli.js",
    "test": "node --test",
    "check": "node --check ./src/cli.js && node --check ./src/scanner.js && node --check ./src/formatter.js && node --check ./src/exporter.js"
  },
  "keywords": [
    "directory-tree",
    "folder-tree",
    "cli",
    "developer-tools",
    "filesystem"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ignore": "^5.3.2"
  }
}
